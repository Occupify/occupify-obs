{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "orange", "value": 400 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status Code" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Correlation / Trace ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "🔍 Trace in Live Log Stream",
                    "url": "/grafana/d/occupify-log-explorer/occupify-unified-log-explorer?var-service=All&var-search=${__value.raw}"
                  },
                  {
                    "title": "🌐 View Waterfall in Distributed Tracing",
                    "url": "/grafana/d/occupify-distributed-tracing/occupify-distributed-tracing?var-trace_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Request Audit: Endpoints, Correlation IDs & Status",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "{service=\"gateway\"} |~ \"Corr-\" | regexp `\\[Corr-(?P<c1>[0-9a-fA-F]{8})-(?P<c2>[0-9a-fA-F]{4})-(?P<c3>[0-9a-fA-F]{4})-(?P<c4>[0-9a-fA-F]{4})-(?P<c5>[0-9a-fA-F]{12})\\]` | label_format TraceID=\"{{.c1}}{{.c2}}{{.c3}}{{.c4}}{{.c5}}\" | label_format Correlation_ID=\"{{.c1}}-{{.c2}}-{{.c3}}-{{.c4}}-{{.c5}}\" | regexp `(?:request for \\[(?P<Endpoint1>[^\\]]+)\\]: Status (?P<Status1>[0-9]+)|Completed request: [A-Z]+ (?P<Endpoint2>[^ ]+) -> Route \\[[^\\]]+\\] with status \\[(?P<Status2>[^\\] -]+)\\]|Routing request: [A-Z]+ (?P<Endpoint3>[^ ]+))` | label_format Endpoint=\"{{if .Endpoint1}}{{.Endpoint1}}{{else if .Endpoint2}}{{.Endpoint2}}{{else if .Endpoint3}}{{.Endpoint3}}{{else}}/{{end}}\" | label_format Status=\"{{if .Status1}}{{.Status1}}{{else if .Status2}}{{.Status2}}{{else}}200{{end}}\"",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "auto",
            "replace": false,
            "source": "labels"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Endpoint1": true,
              "Endpoint2": true,
              "Endpoint3": true,
              "Status1": true,
              "Status2": true,
              "TraceID": true,
              "c1": true,
              "c2": true,
              "c3": true,
              "c4": true,
              "c5": true,
              "container": true,
              "detected_level": true,
              "host": true,
              "id": true,
              "job": true,
              "labelTypes": true,
              "labels": true,
              "service": true,
              "service_name": true,
              "syslog_identifier": true,
              "tsNs": true
            },
            "indexByName": {
              "Correlation_ID": 3,
              "Endpoint": 1,
              "Line": 4,
              "Status": 2,
              "Time": 0
            },
            "renameByName": {
              "Correlation_ID": "Correlation / Trace ID",
              "Endpoint": "Request Endpoint",
              "Line": "Log Details",
              "Status": "Status Code",
              "Time": "Time"
            }
          }
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 9 },
      "id": 1,
      "title": "Log Ingestion Volume per Service",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 14 },
      "id": 2,
      "title": "Unified Live Service Log Stream",
      "type": "logs",
      "targets": [
        {
          "expr": "{service=~\"$service\"} |= \"$search\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["occupify", "logs"],
  "templating": {
    "list": [
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(service)",
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values(service)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "text": "", "value": "" },
        "name": "search",
        "type": "textbox",
        "label": "Filter Search"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Occupify Unified Log Explorer",
  "uid": "occupify-log-explorer",
  "version": 7
}
