{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "orange", "value": 400 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Correlation_ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "🔍 Trace Waterfall for ${__value.raw}",
                    "url": "/grafana/d/occupify-distributed-tracing/occupify-distributed-tracing?var-trace_id=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Request Audit: Endpoints, Correlation IDs & Status",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "{service=~\"$service\"} |~ \"Corr-\" | regexp \"\\\\[Corr-(?P<Correlation_ID>[a-zA-Z0-9-]+)\\\\] (?:Completed request: [A-Z]+ (?P<Endpoint>[^ ]+) -> Route \\\\[[^\\\\]]*\\\\] with status \\\\[(?P<Status>[^\\\\]]+)\\\\]|Client error handling request for \\\\[(?P<Endpoint>[^\\\\]]+)\\\\]: Status (?P<Status>[0-9]+)|Routing request: [A-Z]+ (?P<Endpoint>[^ ]+)|.*header for path: (?P<Endpoint>[^ \\\\n]+))\" | label_format Status=\"{{if .Status}}{{.Status}}{{else}}200 OK{{end}}\"",
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "container": true,
              "host": false,
              "id": true,
              "job": true,
              "syslog_identifier": true
            },
            "indexByName": {},
            "renameByName": {
              "Correlation_ID": "Correlation ID (Click to Trace)",
              "Endpoint": "Request Endpoint",
              "Line": "Log Message",
              "Status": "Status",
              "Time": "Time",
              "host": "Host IP",
              "service": "Service"
            }
          }
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 9 },
      "id": 1,
      "title": "Log Ingestion Volume per Service",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 14 },
      "id": 2,
      "title": "Unified Live Service Log Stream",
      "type": "logs",
      "targets": [
        {
          "expr": "{service=~\"$service\"} |= \"$search\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["occupify", "logs"],
  "templating": {
    "list": [
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(service)",
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values(service)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "text": "", "value": "" },
        "name": "search",
        "type": "textbox",
        "label": "Filter Search"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Occupify Unified Log Explorer",
  "uid": "occupify-log-explorer",
  "version": 2
}
